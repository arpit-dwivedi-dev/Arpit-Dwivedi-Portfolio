# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_WEB3FORMS_KEY: Access key for the contact form's email delivery (web3forms.com).
# Get one free at https://web3forms.com/ — enter your inbox email, they email you this key.
# Safe to expose client-side: it only lets people submit mail to you via this form.
VITE_WEB3FORMS_KEY="MY_WEB3FORMS_ACCESS_KEY"

# VITE_SENTRY_DSN: Enables real-time error tracking, performance tracing, and
# session replay via Sentry (sentry.io). Create a free React project there —
# the DSN it gives you is meant to be public/client-side, not a secret.
# Leave unset to disable all three (no requests fire without it).
VITE_SENTRY_DSN="MY_SENTRY_DSN"

# VITE_GA_MEASUREMENT_ID: Enables Google Analytics 4 (real-time visitor count,
# page views, referrers). Create a free GA4 property at analytics.google.com,
# then use its Measurement ID (format: G-XXXXXXXXXX).
# Leave unset to disable analytics entirely (no script loads without it).
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# VITE_TOOLS_API_URL: base URL of the 101techlabs-tools-api backend (see that
# project's README for deployment). Leave unset to run the Google Maps
# Scraper in demo mode against locally-generated sample data — everything
# still works, it just isn't live. Example: https://tools-api.101techlabs.com
VITE_TOOLS_API_URL=
